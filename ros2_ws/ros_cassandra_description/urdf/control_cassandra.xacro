<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:arg name="dc_motor_dry_run" default="false"/>
    <xacro:property name="max_wheel_speed_rad_s" value="16.6666666667"/>

    <ros2_control name="CassandraBaseHardware" type="system">
        <hardware>
            <plugin>dc_motor_controller/DCMotorSystemHardware</plugin>
            <param name="i2c_device">/dev/i2c-1</param>
            <param name="i2c_address">0x40</param>
            <param name="pwm_frequency">1000</param>
            <param name="min_pwm_percent">8.0</param>
            <param name="max_pwm_percent">15.0</param>
            <param name="max_wheel_speed_rad_s">${max_wheel_speed_rad_s}</param>
            <param name="command_deadband_rad_s">0.05</param>
            <param name="linear_velocity_state_scale">0.5</param>
            <param name="dry_run">$(arg dc_motor_dry_run)</param>
        </hardware>
        <joint name="joint_front_left_wheel">
            <command_interface name="velocity">
                <param name="min">-${max_wheel_speed_rad_s}</param>
                <param name="max">${max_wheel_speed_rad_s}</param>
            </command_interface>
            <state_interface name="velocity"/>
            <state_interface name="position"/>
            <param name="forward_channel">4</param>
            <param name="reverse_channel">5</param>
            <param name="direction">-1</param>
        </joint>
        <joint name="joint_rear_left_wheel">
            <command_interface name="velocity">
                <param name="min">-${max_wheel_speed_rad_s}</param>
                <param name="max">${max_wheel_speed_rad_s}</param>
            </command_interface>
            <state_interface name="velocity"/>
            <state_interface name="position"/>
            <param name="forward_channel">8</param>
            <param name="reverse_channel">9</param>
            <param name="direction">-1</param>
        </joint>
        <joint name="joint_front_right_wheel">
            <command_interface name="velocity">
                <param name="min">-${max_wheel_speed_rad_s}</param>
                <param name="max">${max_wheel_speed_rad_s}</param>
            </command_interface>
            <state_interface name="velocity"/>
            <state_interface name="position"/>
            <param name="forward_channel">7</param>
            <param name="reverse_channel">6</param>
            <param name="direction">-1</param>
        </joint>
        <joint name="joint_rear_right_wheel">
            <command_interface name="velocity">
                <param name="min">-${max_wheel_speed_rad_s}</param>
                <param name="max">${max_wheel_speed_rad_s}</param>
            </command_interface>
            <state_interface name="velocity"/>
            <state_interface name="position"/>
            <param name="forward_channel">11</param>
            <param name="reverse_channel">10</param>
            <param name="direction">-1</param>
        </joint>
    </ros2_control>
    <ros2_control name="servos_controller" type="system">
        <hardware>
            <plugin>mock_components/GenericSystem</plugin>
        </hardware>
        <joint name="right_shoulder_joint">
            <command_interface name="position">
              <param name="min">-1.15</param>
              <param name="max">1.4</param>
            </command_interface>
            <state_interface name="position"/>
        </joint>
        <joint name="left_shoulder_joint">
            <command_interface name="position">
              <param name="min">-1.15</param>
              <param name="max">1.4</param>
            </command_interface>
            <state_interface name="position"/>
        </joint>

        <joint name="right_shoulder_low_joint">
            <command_interface name="position">
              <param name="min">-2.2</param>
              <param name="max">0</param>
            </command_interface>
            <state_interface name="position"/>
        </joint>
        <joint name="left_shoulder_low_joint">
            <command_interface name="position">
              <param name="min">-2.2</param>
              <param name="max">0</param>
            </command_interface>
            <state_interface name="position"/>
        </joint>

        <joint name="right_bicep_joint">
            <command_interface name="position">
              <param name="min">-1.7</param>
              <param name="max">0.5</param>
            </command_interface>
            <state_interface name="position"/>
        </joint>
        <joint name="left_bicep_joint">
            <command_interface name="position">
              <param name="min">-1.7</param>
              <param name="max">0.5</param>
            </command_interface>
            <state_interface name="position"/>
        </joint>

        <joint name="left_arm_joint">
            <command_interface name="position">
              <param name="min">-2.2</param>
              <param name="max">0</param>
            </command_interface>
            <state_interface name="position"/>
        </joint>
        <joint name="right_arm_joint">
            <command_interface name="position">
              <param name="min">-2.2</param>
              <param name="max">0</param>
            </command_interface>
            <state_interface name="position"/>
        </joint>
        
        <joint name="upper_torso_joint">
            <command_interface name="position">
              <param name="min">-2.2</param>
              <param name="max">0</param>
            </command_interface>
            <state_interface name="position"/>
        </joint>

        <joint name="head_yaw_joint">
            <command_interface name="position">
              <param name="min">-1.0</param>
              <param name="max">1.0</param>
            </command_interface>
            <state_interface name="position"/>
        </joint>

        <joint name="head_pitch_joint">
            <command_interface name="position">
              <param name="min">-0.8</param>
              <param name="max">0.8</param>
            </command_interface>
            <state_interface name="position"/>
        </joint>
    </ros2_control>
</robot>
